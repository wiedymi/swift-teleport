ARG TELEPORT_IMAGE
ARG DEBIAN_IMAGE
FROM ${TELEPORT_IMAGE} AS teleport
FROM ${DEBIAN_IMAGE}
ARG DEBIAN_SNAPSHOT
RUN rm -f /etc/apt/sources.list.d/debian.sources && \
    printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s/ bookworm main\ndeb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/%s/ bookworm-security main\n' "$DEBIAN_SNAPSHOT" "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list && \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends ca-certificates libpam0g libaudit1 libcap2 libsystemd0 libstdc++6 tmux netcat-openbsd iproute2 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --create-home --shell /bin/bash --uid 1000 vvterm-test && \
    passwd --delete vvterm-test
COPY --from=teleport /usr/local/bin/teleport /usr/local/bin/teleport
COPY --from=teleport /usr/bin/dumb-init /usr/bin/dumb-init
RUN ldd /usr/local/bin/teleport && /usr/local/bin/teleport version
ENTRYPOINT ["/usr/bin/dumb-init", "/usr/local/bin/teleport", "start", "--config=/etc/teleport/teleport.yaml"]
