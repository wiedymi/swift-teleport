+/* Import the certified key for SSH key-exchange signature verification.
+ * The complete certificate remains in session->server_hostkey. The caller
+ * MUST validate its CA signature, principal, validity, and critical options
+ * before authentication or opening channels. This is not a trust policy.
+ */
+static int
+hostkey_cert_init(LIBSSH2_SESSION *session,
+                 const unsigned char *data, size_t data_len,
+                 void **abstract, const char *cert_type,
+                 const char *plain_type, unsigned int field_count,
+                 int (*plain_init)(LIBSSH2_SESSION *, const unsigned char *,
+                                   size_t, void **))
+{
+    struct string_buf buf;
+    unsigned char *ignored, *fields, *plain;
+    size_t ignored_len, fields_len, plain_len;
+    size_t type_len = strlen(plain_type);
+    libssh2_uint64_t serial, valid_after, valid_before;
+    uint32_t cert_kind;
+    unsigned int i;
+    int rc;
+
+    buf.data = (unsigned char *)data;
+    buf.dataptr = buf.data;
+    buf.len = data_len;
+    if(_libssh2_match_string(&buf, cert_type) ||
+       _libssh2_get_string(&buf, &ignored, &ignored_len))
+        return -1;
+
+    fields = buf.dataptr;
+    for(i = 0; i < field_count; i++) {
+        if(_libssh2_get_string(&buf, &ignored, &ignored_len))
+            return -1;
+    }
+    fields_len = (size_t)(buf.dataptr - fields);
+
+    if(_libssh2_get_u64(&buf, &serial) ||
+       _libssh2_get_u32(&buf, &cert_kind) || cert_kind != 2 ||
+       _libssh2_get_string(&buf, &ignored, &ignored_len) ||
+       _libssh2_get_string(&buf, &ignored, &ignored_len) ||
+       _libssh2_get_u64(&buf, &valid_after) ||
+       _libssh2_get_u64(&buf, &valid_before))
+        return -1;
+    /* Critical options, extensions, and reserved data are checked by the
+     * caller's certificate policy, not by the key-exchange importer. */
+    for(i = 0; i < 3; i++) {
+        if(_libssh2_get_string(&buf, &ignored, &ignored_len))
+            return -1;
+    }
+    if(_libssh2_get_string(&buf, &ignored, &ignored_len) || !ignored_len ||
+       _libssh2_get_string(&buf, &ignored, &ignored_len) || !ignored_len ||
+       !_libssh2_eob(&buf))
+        return -1;
+
+    /* The encoded plain key is smaller than the encoded certificate. */
+    if(data_len < 4 + type_len || fields_len > data_len - 4 - type_len)
+        return -1;
+    plain_len = 4 + type_len + fields_len;
+    plain = LIBSSH2_ALLOC(session, plain_len);
+    if(!plain)
+        return -1;
+    _libssh2_htonu32(plain, (uint32_t)type_len);
+    memcpy(plain + 4, plain_type, type_len);
+    memcpy(plain + 4 + type_len, fields, fields_len);
+    rc = plain_init(session, plain, plain_len, abstract);
+    LIBSSH2_FREE(session, plain);
+    return rc;
+}
